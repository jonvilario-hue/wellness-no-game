
{
  "template_id": "ts_te_interface_bug",
  "source_repo": "typescript-exercises/typescript-exercises",
  "drill_type": "bug_hunt",
  "concept_tags": ["interfaces", "optional_properties"],
  "requires_type_checker": true,
  "difficulty": "beginner",
  "prompt_template": "interface {{TYPE}} {\n  {{P1}}: {{T1}};\n  {{P2}}: {{T2}};\n}\n\nconst item: {{TYPE}} = {\n  {{P1}}: {{VAL1}},\n  // Error: Property '{{P2}}' is missing in type '{ {{P1}}: {{T1}} }' but required in type '{{TYPE}}'.\n};\n\n// Goal: Fix the interface definition to make {{P2}} optional.",
  "slot_definitions": {
    "TYPE": { "type": "string_pool", "pool": ["Person", "Item", "Config", "Settings"] },
    "P1": { "type": "string_pool", "pool": ["id", "name", "key"] },
    "T1": { "type": "type_primitives" },
    "P2": { "type": "string_pool", "pool": ["age", "description", "value"] },
    "T2": { "type": "type_primitives" },
    "VAL1": { "type": "string_pool", "pool": ["1", "'Alice'", "true"] }
  },
  "answer_derivation": "Add '?' to {{P2}} in the interface",
  "variation_minimum": 15,
  "max_prompt_words": 50,
  "max_feedback_words": 20,
  "time_limit_seconds": 60
}
