
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global templates are readable by anyone, but only system (admin logic) can write
    match /blueprintTemplates/{templateId} {
      allow read: if request.auth != null;
      allow write: if false; // Only manageable via admin/server logic
    }

    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Validation helpers
    function isValidAmount(val) {
      return val is number && val > 0;
    }
    
    match /users/{userId}/financeTransactions/{txId} {
      allow create, update: if isValidAmount(request.resource.data.amount);
    }
  }
}
