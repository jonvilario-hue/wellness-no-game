
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    match /users/{userId} {
      allow get, write: if isOwner(userId);
      match /anki-decks/{deckId} { allow read, write: if isOwner(userId); }
    }

    match /mealPlans/{docId} {
      allow read, write: if isSignedIn() && docId.startsWith(request.auth.uid);
    }

    match /shoppingLists/{docId} {
      allow read, write: if isSignedIn() && docId.startsWith(request.auth.uid);
    }

    match /mealGuides/{guideId} {
      allow read: if isSignedIn();
      allow write: if false; // System only
    }

    match /ingredientPrices/{priceId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }
  }
}
