
{
  "entities": {
    "AnkiDeck": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AnkiDeck",
      "type": "object",
      "description": "Represents the metadata for an uploaded Anki flashcard deck file (.apkg) stored in Firebase Storage.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "fileName": { "type": "string" },
        "displayName": { "type": "string" },
        "fileSize": { "type": "number" },
        "downloadUrl": { "type": "string", "format": "uri" },
        "uploadedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "fileName", "displayName", "fileSize", "downloadUrl", "uploadedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "storageUsedBytes": { "type": "number" },
        "storageQuotaBytes": { "type": "number" },
        "deckCount": { "type": "number" },
        "dietaryProfile": {
          "type": "object",
          "properties": {
            "allergies": { "type": "array", "items": { "type": "string" } },
            "dietaryPreference": { "type": "string", "enum": ["omnivore", "vegetarian", "vegan", "pescatarian", "halal", "kosher"] },
            "medicalRestrictions": { "type": "array", "items": { "type": "string" } },
            "weeklyFoodBudget": { "type": "number" },
            "maxPrepTimeMinutes": { "type": "number" },
            "householdSize": { "type": "number" }
          }
        }
      }
    },
    "MealPlan": {
      "title": "MealPlan",
      "type": "object",
      "description": "Calendar-based meal assignment.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slot": { "type": "string", "enum": ["Breakfast", "Lunch", "Dinner", "Snacks"] },
              "foodId": { "type": "string" },
              "foodName": { "type": "string" },
              "servings": { "type": "number" },
              "logged": { "type": "boolean" },
              "loggedAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },
    "MealGuide": {
      "title": "MealGuide",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "targetCalories": { "type": "number" },
        "macroRatios": { "type": "object" },
        "costRange": { "type": "object" },
        "templateDays": { "type": "array" }
      }
    },
    "ShoppingList": {
      "title": "ShoppingList",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "weekStart": { "type": "string" },
        "items": { "type": "array" }
      }
    },
    "IngredientPrice": {
      "title": "IngredientPrice",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "unit": { "type": "string" },
        "price": { "type": "number" },
        "source": { "type": "string" },
        "userId": { "type": "string" }
      }
    }
  },
  "auth": { "providers": ["password", "anonymous"] },
  "firestore": {
    "structure": [
      { "path": "/users/{userId}", "definition": { "entityName": "UserProfile", "description": "User settings." } },
      { "path": "/mealPlans/{userId_date}", "definition": { "entityName": "MealPlan", "description": "Daily meal assignments." } },
      { "path": "/mealGuides/{guideId}", "definition": { "entityName": "MealGuide", "description": "Pre-built nutritional protocols." } },
      { "path": "/shoppingLists/{userId_weekStart}", "definition": { "entityName": "ShoppingList", "description": "Aggregated ingredients." } },
      { "path": "/ingredientPrices/{priceId}", "definition": { "entityName": "IngredientPrice", "description": "Estimate database." } }
    ]
  }
}
