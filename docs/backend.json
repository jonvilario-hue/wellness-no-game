
{
  "entities": {
    "AnkiDeck": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AnkiDeck",
      "type": "object",
      "description": "Metadata for an uploaded Anki flashcard deck file (.apkg).",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "fileName": { "type": "string" },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "fileSize": { "type": "number" },
        "downloadUrl": { "type": "string", "format": "uri" },
        "uploadedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "fileName", "displayName", "fileSize", "downloadUrl", "uploadedAt"]
    },
    "FlashcardDeck": {
      "title": "FlashcardDeck",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "settings": { "type": "object" }
      },
      "required": ["id", "name"]
    },
    "Flashcard": {
      "title": "Flashcard",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "deckId": { "type": "string" },
        "front": { "type": "string" },
        "back": { "type": "string" },
        "type": { "type": "string", "enum": ["basic", "cloze", "basic-reversed", "image-occlusion", "type-in"] },
        "dueDate": { "type": "string", "format": "date-time" },
        "interval": { "type": "number" },
        "easeFactor": { "type": "number" },
        "repetitions": { "type": "number" },
        "lapses": { "type": "number" },
        "suspended": { "type": "boolean" },
        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "deckId", "front", "back", "type", "dueDate"]
    },
    "MathSession": {
      "title": "MathSession",
      "type": "object",
      "description": "A record of a mathematical composure practice session.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "domainId": { "type": "string" },
        "mode": { "type": "string", "enum": ["Slow Work", "Steady Rhythm", "Real Life"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "problemsAttempted": { "type": "number" },
        "habitsOfMind": { "type": "array", "items": { "type": "string" } },
        "feeling": { "type": "string", "enum": ["Grounded", "Shaky"] },
        "isApplied": { "type": "boolean" }
      },
      "required": ["id", "userId", "domainId", "mode", "timestamp", "feeling"]
    }
  },
  "auth": { "providers": ["password", "anonymous"] },
  "firestore": {
    "structure": [
      { "path": "/users/{userId}/anki-decks/{deckId}", "definition": { "entityName": "AnkiDeck", "description": "Cloud metadata for Anki files." } },
      { "path": "/users/{userId}/flashcard-decks/{deckId}", "definition": { "entityName": "FlashcardDeck", "description": "User created study decks." } },
      { "path": "/users/{userId}/flashcard-decks/{deckId}/cards/{cardId}", "definition": { "entityName": "Flashcard", "description": "Individual cards within a deck." } },
      { "path": "/users/{userId}/math-sessions/{sessionId}", "definition": { "entityName": "MathSession", "description": "Mathematical composure logs." } }
    ]
  }
}
