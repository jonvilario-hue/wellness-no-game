
{
  "template_id": "rs_ex_option_01",
  "source_repo": "exercism/rust",
  "drill_type": "reconstruction",
  "concept_tags": ["pattern_matching", "options"],
  "difficulty": "beginner",
  "prompt_template": "fn maybe_double(val: Option<i32>) -> i32 {\n    {{SLOT_MATCH}}\n}",
  "slot_definitions": {
    "VAL": { "type": "variable_name", "pool": ["input", "num", "opt"] },
    "SLOT_MATCH": { "type": "data_structure", "pool": ["match val { Some(x) => x * 2, None => 0 }", "val.map(|x| x * 2).unwrap_or(0)"] }
  },
  "answer_derivation": "val.unwrap_or(0) * 2",
  "variation_minimum": 15,
  "max_prompt_words": 40,
  "max_feedback_words": 20,
  "time_limit_seconds": 90
}
