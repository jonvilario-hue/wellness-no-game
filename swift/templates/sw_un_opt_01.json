
{
  "template_id": "sw_un_opt_01",
  "source_repo": "twostraws/Unwrap",
  "drill_type": "output_prediction",
  "concept_tags": ["optionals", "nil_coalescing"],
  "difficulty": "beginner",
  "swift_version_minimum": "5.0",
  "prompt_template": "let {{VAR}}: {{TYPE}} = {{VAL}}\nlet result = {{VAR}} ?? {{DEFAULT}}\nprint(result)",
  "slot_definitions": {
    "VAR": { "type": "variable_name", "pool": ["name", "score", "status", "input"] },
    "TYPE": { "type": "string_pool", "pool": ["String?", "Int?", "Bool?"] },
    "VAL": { "type": "string_pool", "pool": ["nil", "\"Swift\"", "42", "true"] },
    "DEFAULT": { "type": "string_pool", "pool": ["\"Unknown\"", "0", "false"] }
  },
  "answer_derivation": "VAL == 'nil' ? DEFAULT : VAL",
  "variation_minimum": 20,
  "max_prompt_words": 15,
  "max_feedback_words": 15,
  "time_limit_seconds": 30
}
